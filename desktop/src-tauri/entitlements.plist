<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the notarized, hardened-runtime BeatForge build.
  BeatForge is distributed with a Developer ID certificate (not the App Store),
  so it is NOT sandboxed. The JIT / unsigned-memory / library-validation
  relaxations are required by the WKWebView runtime, and disabling library
  validation lets the app spawn the external Python engine cleanly.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
