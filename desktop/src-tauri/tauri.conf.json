{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StepForge",
  "version": "0.1.0",
  "identifier": "com.sweetpapatech.stepforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StepForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Turn any song into playable StepMania / ITGmania dance charts",
    "longDescription": "StepForge charts any song for StepMania and ITGmania with StepForge Flow, a small neural model that runs on your computer. No account, no API key, no per-song cost.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.3"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Sweet Papa Technologies",
    "copyright": "\u00a9 2026 Sweet Papa Technologies",
    "homepage": "https://github.com/Sweet-Papa-Technologies/StepForge",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
